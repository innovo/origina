# Copy to .env for local use. On Vercel, add these under Settings > Environment Variables.

# Required in production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=https://origina.co.za
PLATFORM_ADMIN_EMAILS=you@innovonet.co.za

# AI indicator (optional; without it reports show "Not available")
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001

# Leave empty in production so every client can sign up
ALLOWED_SIGNUP_DOMAINS=
# Extra allowed origins, comma separated (only if you serve from more than one domain)
TRUSTED_ORIGINS=
# Must stay false/unset in production
DEMO_MODE=false

# Payments (PayFast). Use PAYFAST_SANDBOX=true with sandbox details while testing.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false
# Pro price per staff seat per month, in rand
PRO_SEAT_PRICE_RAND=89

# Email for verification, password reset and receipts (resend.com)
RESEND_API_KEY=
EMAIL_FROM=Origina <no-reply@origina.co.za>
